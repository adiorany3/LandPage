---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ResearchMap from '@/components/ResearchMap.astro';
import BlogFeed from '@/components/BlogFeed.astro';
import { links, projects, stack, stats, workflow } from '@/data/site';

const year = new Date().getFullYear();
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Galuh Adi Insani',
  alternateName: 'adiorany3',
  url: 'https://adioranye.vercel.app/',
  sameAs: links.map((link) => link.href),
  jobTitle: 'AgriTech & Scientific Computing Developer',
  knowsAbout: ['AgriTech', 'Scientific Computing', 'Statistical Analysis', 'FastAPI', 'Astro']
};
---
<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  <a class="skip-link" href="#main">Lewati ke konten utama</a>
  <div class="ambient ambient-one" aria-hidden="true"></div>
  <div class="ambient ambient-two" aria-hidden="true"></div>
  <div class="ambient-grid" aria-hidden="true"></div>

  <Header />

  <main id="main">
    <section class="hero" id="overview" aria-labelledby="hero-title">
      <div class="hero-copy reveal is-visible">
        <p class="eyebrow">AgriTech • Statistics • Scientific Computing</p>
        <h1 id="hero-title">Portfolio produk riset yang rapi, jelas, dan terasa premium.</h1>
        <p class="lead">Saya membangun aplikasi web yang mengubah rumus peternakan, workflow statistik, dan data penelitian menjadi produk digital yang mudah dipakai.</p>
        <div class="hero-actions">
          <a class="button primary" href="#projects">Lihat showcase</a>
          <a class="button secondary" href="https://github.com/adiorany3" target="_blank" rel="noreferrer">Buka GitHub</a>
        </div>
        <div class="stats" aria-label="Ringkasan portfolio">
          {stats.map((item) => <div><strong>{item.value}</strong><span>{item.label}</span></div>)}
        </div>
      </div>

      <div class="hero-visual reveal is-visible" aria-label="Pratinjau produk Ruminant Nutrition OS">
        <span class="product-pill">Ruminant Nutrition OS</span>
        <img src="/assets/hero-product.svg" width="900" height="740" alt="Dashboard nutrisi, biaya, dan rekomendasi ransum" />
        <div class="glass-card avatar-card">
          <img src="/assets/avatar.svg" width="48" height="48" alt="Avatar Galuh Adi Insani" />
          <div><strong>Galuh Adi</strong><span>Research Tools Builder</span></div>
        </div>
        <div class="floating-tags" aria-hidden="true"><span>Formulation</span><span>Analysis</span><span>Export</span></div>
      </div>
    </section>

    <section class="section intro-section">
      <div class="section-heading reveal">
        <p class="eyebrow">Professional direction</p>
        <h2>Visual dan teks bergerak ke tujuan yang sama.</h2>
        <p>Setiap bagian menjelaskan fungsi produk. Pengunjung dapat memahami konteks, metode, dan hasil tanpa membuka setiap repository.</p>
      </div>
    </section>

    <section class="section github-section" id="github" aria-labelledby="github-title">
      <div class="profile-card reveal">
        <div class="profile-main">
          <img src="/assets/avatar.svg" width="96" height="96" alt="Monogram Galuh Adi Insani" />
          <div>
            <p class="eyebrow">GitHub Profile</p>
            <h2 id="github-title">Profil developer disusun seperti product brief.</h2>
            <h3>Galuh Adi Insani</h3>
            <span>@adiorany3</span>
            <p>Developer dari Indonesia yang fokus pada software AgriTech, statistical analysis, web apps, scientific computing, dan open-source tooling.</p>
            <div class="profile-links">{links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}</div>
          </div>
        </div>
        <div class="profile-metrics">
          <div><strong>46</strong><span>Public repos</span></div>
          <div><strong>6</strong><span>Featured products</span></div>
          <div><strong>8</strong><span>Main technologies</span></div>
          <div><strong>1</strong><span>Clear product focus</span></div>
        </div>
      </div>
    </section>

    <ResearchMap />

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="section-heading reveal">
        <p class="eyebrow">Featured Products</p>
        <h2 id="projects-title">Project GitHub dirapikan sebagai katalog produk.</h2>
        <p>Judul, visual, deskripsi, dan tag menjelaskan fungsi setiap project secara konsisten.</p>
      </div>
      <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
    </section>

    <section class="section workflow-section" id="process" aria-labelledby="process-title">
      <div class="section-heading reveal">
        <p class="eyebrow">Workflow</p>
        <h2 id="process-title">Dari rumus akademik ke produk yang bisa dipakai.</h2>
      </div>
      <div class="workflow-grid">
        {workflow.map((item) => <article class="workflow-card reveal"><span>{item.step}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}
      </div>
    </section>

    <section class="section stack-section" aria-labelledby="stack-title">
      <div class="stack-card reveal">
        <p class="eyebrow">Main Stack</p>
        <h2 id="stack-title">Scientific computing bertemu product engineering.</h2>
        <p>Stack mendukung kalkulasi ilmiah, prototyping cepat, API development, dan landing page modern.</p>
        <div class="tag-list large">{stack.map((item) => <span>{item}</span>)}</div>
      </div>
    </section>

    <BlogFeed />

    <section class="section contact-section" id="contact" aria-labelledby="contact-title">
      <div class="contact-card reveal">
        <p class="eyebrow">Connect</p>
        <h2 id="contact-title">Bangun research tool yang terlihat serius dan memang dipakai.</h2>
        <p>Cocok untuk kolaborasi open-source, aplikasi riset, dashboard statistik, produk AgriTech, dan web app berbasis data.</p>
        <div class="hero-actions">{links.map((link) => <a class="button secondary" href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}</div>
      </div>
    </section>
  </main>

  <footer class="site-footer"><span>© {year} Galuh Adi Insani. Astro portfolio.</span><a href="#top">Back to top ↑</a></footer>
  <button class="back-to-top" id="back-to-top" type="button" aria-label="Kembali ke atas">↑</button>

  <script>
    const revealItems = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });
    revealItems.forEach((item) => revealObserver.observe(item));

    const backToTop = document.querySelector<HTMLButtonElement>('#back-to-top');
    window.addEventListener('scroll', () => backToTop?.classList.toggle('is-visible', window.scrollY > 700), { passive: true });
    backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  </script>
</BaseLayout>
