---
import type { Project } from '@/data/site';
interface Props { project: Project; }
const { project } = Astro.props;
---
<article class="project-card reveal">
  <div class="project-visual">
    <img src={project.image} alt={project.alt} loading="lazy" width="720" height="440" />
  </div>
  <div class="project-body">
    <p class="eyebrow">{project.eyebrow}</p>
    <h3>{project.name}</h3>
    <p>{project.description}</p>
    <div class="tag-list">
      {project.tags.map((tag) => <span>{tag}</span>)}
    </div>
    <a class="text-link" href={project.repo} target="_blank" rel="noreferrer">Repository <span aria-hidden="true">↗</span></a>
  </div>
</article>
