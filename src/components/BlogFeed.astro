---
import { fallbackPosts } from '@/data/site';
---
<section class="section journal-section" id="journal" aria-labelledby="journal-title">
  <div class="section-heading reveal">
    <p class="eyebrow">Catatan Insani</p>
    <h2 id="journal-title">Catatan tentang riset, data, dan proses membangun produk.</h2>
    <p>Konten awal tetap tersedia untuk SEO. Browser akan memperbaruinya dari WordPress saat API dapat diakses.</p>
  </div>
  <div class="journal-grid" id="journal-grid">
    {fallbackPosts.map((post) => (
      <article class="journal-card reveal">
        <p class="eyebrow">Journal</p>
        <h3><a href={post.href} target="_blank" rel="noreferrer">{post.title}</a></h3>
        <p>{post.excerpt}</p>
        <a class="text-link" href={post.href} target="_blank" rel="noreferrer">Baca catatan <span aria-hidden="true">↗</span></a>
      </article>
    ))}
  </div>
</section>

<script>
  type WpPost = {
    link: string;
    title: { rendered: string };
    excerpt: { rendered: string };
  };

  const strip = (value: string) => {
    const doc = new DOMParser().parseFromString(value, 'text/html');
    return doc.body.textContent?.trim() ?? '';
  };

  const grid = document.querySelector<HTMLElement>('#journal-grid');
  fetch('https://public-api.wordpress.com/wp/v2/sites/catataninsani.wordpress.com/posts?per_page=3&_fields=link,title,excerpt')
    .then((response) => {
      if (!response.ok) throw new Error('WordPress request failed');
      return response.json() as Promise<WpPost[]>;
    })
    .then((posts) => {
      if (!grid || !posts.length) return;
      grid.innerHTML = posts.map((post) => `
        <article class="journal-card is-visible">
          <p class="eyebrow">Latest journal</p>
          <h3><a href="${post.link}" target="_blank" rel="noreferrer">${strip(post.title.rendered)}</a></h3>
          <p>${strip(post.excerpt.rendered).slice(0, 190)}${strip(post.excerpt.rendered).length > 190 ? '…' : ''}</p>
          <a class="text-link" href="${post.link}" target="_blank" rel="noreferrer">Baca catatan <span aria-hidden="true">↗</span></a>
        </article>
      `).join('');
    })
    .catch(() => {
      // Fallback markup remains visible when WordPress is unavailable.
    });
</script>
